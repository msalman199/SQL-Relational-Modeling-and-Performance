FROM users u
JOIN orders o ON u.user_id = o.user_id
WHERE o.order_date > NOW() - INTERVAL '180 days'
GROUP BY u.username
HAVING COUNT(o.order_id) > 5
ORDER BY SUM(o.amount) DESC
LIMIT 10;
