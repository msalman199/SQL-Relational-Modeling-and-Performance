Task 1: Analyze Slow Queries
Step 1: Enable Query Timing
-- Enable timing in psql
\timing on
Step 2: Run Baseline Queries
Execute these queries and record execution times:

-- Query 1: Find user orders (no index)
SELECT u.username, COUNT(o.order_id) as order_count, SUM(o.amount) as total_spent
FROM users u
LEFT JOIN orders o ON u.user_id = o.user_id
WHERE u.email LIKE '%5000@%'
GROUP BY u.username;

-- Query 2: Search orders by date range
SELECT * FROM orders 
WHERE order_date BETWEEN '2024-01-01' AND '2024-06-30'
ORDER BY amount DESC
LIMIT 100;

-- Query 3: Aggregate query
SELECT product_name, COUNT(*) as sales_count, AVG(amount) as avg_price
FROM orders
WHERE amount > 500
GROUP BY product_name
ORDER BY sales_count DESC;
Step 3: Analyze Query Plans
-- Use EXPLAIN ANALYZE to see execution details
EXPLAIN ANALYZE
SELECT u.username, COUNT(o.order_id) as order_count
FROM users u
LEFT JOIN orders o ON u.user_id = o.user_id
WHERE u.email LIKE '%5000@%'
GROUP BY u.username;
