Verification
Verify JOIN Results
-- Check that your multiple JOIN query returns correct product categories
SELECT DISTINCT category 
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id;
-- Should show only 'Electronics' if filtered correctly
Verify Subquery Results
-- Verify products ordered more than once
SELECT product_id, COUNT(*) as order_count
FROM order_items
GROUP BY product_id
HAVING COUNT(*) > 1;
-- Compare with your subquery results
Verify Window Functions
-- Check running total calculation
SELECT order_date, 
       SUM(total_amount) OVER (ORDER BY order_date) as running_total
FROM orders
ORDER BY order_date;
-- Last row should equal total of all orders
